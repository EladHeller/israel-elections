{
  "name": "electionsmonitor",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint:test": "eslint . --max-warnings 0",
    "test": "npm run build:test && tsx --test ./election-results-listener/**/*.test.ts ./elections-client/src/**/*.test.ts ./infra/**/*.test.ts",
    "test:coverage": "c8 -r=text-summary -r=lcov -r=json-summary npm test",
    "check-coverage": "tsx ./infra/CI/check-coverage.ts",
    "upload-coverage": "tsx ./infra/CI/upload-coverage-s3.ts",
    "type-check": "tsc --noEmit",
    "upload-client": "node uploadClient.js",
    "build": "rm -rf dist && tsc",
    "build:test": "rm -rf dist && tsc --sourceMap && tsc infra/s3.ts --outDir dist/infra --target ES2022 --module NodeNext --esModuleInterop --sourceMap --skipLibCheck",
    "deploy": "tsx ./infra/CD/deploy-all.ts",
    "monitor:local": "tsx ./election-results-listener/local-monitor.ts",
    "monitor:local:install": "zsh ./scripts/install-local-election-monitor.sh",
    "monitor:local:uninstall": "zsh ./scripts/uninstall-local-election-monitor.sh",
    "test:ci": "npm run type-check && npm run test:coverage && npm run check-coverage && npm run lint:test",
    "build:client": "cd elections-client && npm ci && npm run build"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1142.0",
    "@aws-sdk/client-cloudfront": "^3.1159.0",
    "@aws-sdk/client-cloudwatch": "^3.1142.0",
    "@aws-sdk/client-lambda": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/lib-storage": "^3.1141.0",
    "convict": "^6.2.5",
    "csv-parse": "^7.0.3",
    "encoding": "^0.1.14",
    "mime-types": "^3.0.2"
  },
  "overrides": {
    "yargs": "17.0.1",
    "fast-xml-parser": "4.1.2",
    "minimatch": "^10.2.2",
    "glob": "^13.0.6",
    "rimraf": "^5.0.5"
  }
}
