{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": false,
        "strictNullChecks": true,
        "types": ["node"],
        "rootDir": "election-results-listener",
        "outDir": "dist"
    },
    "include": [
        "election-results-listener"
    ],
    "exclude": [
        "node_modules",
        "*/__tests__",
        "election-results-listener/question-preview.ts"
    ]
}
